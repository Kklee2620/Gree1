{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "../dist",
    "rootDir": ".."
  },
  "include": ["./**/*.ts", "../server/**/*.ts"],
  "exclude": ["node_modules"]
} 